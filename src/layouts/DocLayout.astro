---
import BaseLayout from './BaseLayout.astro';
const { title, Content, lang } = Astro.props;
const htmlLang = lang === 'kr' ? 'ko' : lang === 'jp' ? 'ja' : lang;
---

<BaseLayout title={title}>
  <article lang={htmlLang} class="card doc-body">
    <h1>{title}</h1>
    <Content />
  </article>
</BaseLayout>

<style>
  .doc-body { min-width: 0; overflow-wrap: anywhere; }
  .doc-body :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.25rem 0; }
  .doc-body :global(th), .doc-body :global(td) { border: 1px solid #dfd8ce; padding: 0.65rem; vertical-align: top; min-width: 8rem; text-align: left; }
  .doc-body :global(th) { background: #efede8; }
  .doc-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 1rem; border-radius: 8px; }
  .doc-body :global(code) { font-size: 0.9em; }
  .doc-body :global(h2) { margin-top: 2rem; }
</style>
